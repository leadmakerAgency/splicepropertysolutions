    {
      "parameters": {
        "jsCode": "const titleRaw = $('Webhook').first().json.body.title || '';\nconst excerptRaw = $('Webhook').first().json.body.excerpt || '';\nconst bodyRaw = $('Webhook').first().json.body.body || '';\n\nconst uploaded = $('Upload image').first().json;\nconst uploadedPath = uploaded?.content?.path || '';\nconst uploadedName = uploaded?.content?.name || '';\n\nconst SITE_URL = 'https://www.splicepropertysolutions.co.uk';\n\nconst clean = (v = '') => String(v).replace(/[\\r\\n]+/g, ' ').trim();\nconst yamlSafe = (v = '') => JSON.stringify(clean(v));\n\nconst toSlug = (v = '') =>\n  clean(v)\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '-')\n    .replace(/^-+|-+$/g, '');\n\nconst title = clean(titleRaw);\nconst slug = toSlug(title);\nconst excerpt = clean(excerptRaw || bodyRaw).slice(0, 240);\nconst body = String(bodyRaw || '').trim();\n\nif (!title || !slug) {\n  throw new Error('Missing or unusable title in the incoming webhook body.');\n}\n\nconst articleUrl = `${SITE_URL}/blog/${slug}`;\n\nconst imageFilename = uploadedName || `image-${slug}.png`;\nconst featuredImage = uploadedPath\n  ? `/${uploadedPath.replace(/^\\/+/, '')}`\n  : `/media/${imageFilename}`;\n\nconst markdown = `---\nlayout: \"blog-post.njk\"\ntitle: ${yamlSafe(title)}\nslug: ${yamlSafe(slug)}\ndate: ${yamlSafe(new Date().toISOString())}\nexcerpt: ${yamlSafe(excerpt)}\nfeatured_image: ${yamlSafe(featuredImage)}\nhero_emoji: \"\"\npermalink: ${yamlSafe(`/blog/${slug}/`)}\n---\n\n${body}\n`;\n\nreturn [\n  {\n    json: {\n      title,\n      slug,\n      articleUrl,\n      imageFilename,\n      featuredImage,\n      postPath: `content/posts/${slug}.md`,\n      mediaPath: uploadedPath || `content/media/${imageFilename}`,\n      markdown\n    }\n  }\n];"
      },
